{
  "name": "frontend-sample",
  "version": "0.3.0-solid.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "routes:generate": "tsr generate",
    "pretypecheck": "npm run routes:generate",
    "pretest:run": "npm run routes:generate",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,css,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "size": "size-limit",
    "prebuild": "npm run routes:generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@modular-forms/solid": "^0.25.1",
    "@sentry/solid": "^10.53.0",
    "@solid-primitives/event-listener": "^2.4.5",
    "@solid-primitives/media": "^2.3.5",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/storage": "^4.3.4",
    "@tanstack/router-plugin": "^1.144.0",
    "@tanstack/solid-query": "^5.90.14",
    "@tanstack/solid-query-devtools": "^5.91.2",
    "@tanstack/solid-router": "^1.144.0",
    "@tanstack/solid-virtual": "^3.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "keycloak-js": "^26.2.4",
    "lucide-solid": "^1.14.0",
    "mitt": "^3.0.1",
    "solid-js": "^1.9.0",
    "solid-sonner": "^0.2.8",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "web-vitals": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.57.0",
    "@size-limit/file": "^12.1.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/router-cli": "^1.144.0",
    "@testing-library/jest-dom": "^6.1.5",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^2.1.6",
    "@vitest/ui": "^2.1.6",
    "autoprefixer": "^10.4.19",
    "babel-preset-solid": "^1.9.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^15.12.0",
    "husky": "^9.0.11",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.2",
    "msw": "^2.12.7",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "rollup-plugin-visualizer": "^6.0.5",
    "size-limit": "^12.1.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.6"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "size-limit": [
    {
      "path": "dist/assets/index-*.js",
      "limit": "120 kB",
      "gzip": true
    },
    {
      "path": "dist/assets/index-*.css",
      "limit": "50 kB",
      "gzip": true
    }
  ]
}
