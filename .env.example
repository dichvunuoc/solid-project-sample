# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# API — point at your gateway or domain microservice
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api

# Optional second microservice (see createHttpClient / secondaryHttpClient)
# VITE_SECONDARY_API_URL=http://localhost:8081/api

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
VITE_APP_NAME="Frontend Sample"
NODE_ENV=development

# -----------------------------------------------------------------------------
# Auth mode:
# - mock: local dev only, stores demo auth state in localStorage
# - keycloak: browser SSO through Authorization Code + PKCE
# - backend-session: placeholder for BFF/server-owned session flows
# Never rely on mock auth in production builds.
# -----------------------------------------------------------------------------
VITE_AUTH_MODE=mock
VITE_USE_MOCK_AUTH=true
# Mock RBAC (dev only): grant roles/permissions to the mock session so you can
# exercise roleGuard / permissionGuard locally. Comma-separated.
VITE_MOCK_ROLES=user
VITE_MOCK_PERMISSIONS=

# -----------------------------------------------------------------------------
# Keycloak SSO — required when VITE_AUTH_MODE=keycloak
# -----------------------------------------------------------------------------
# Base URL of the Keycloak server (no trailing slash).
# VITE_KEYCLOAK_URL=https://iam.example.com
# Realm name.
# VITE_KEYCLOAK_REALM=techgen
# Public SPA client id (one per frontend service unless IAM standardizes shared clients).
# VITE_KEYCLOAK_CLIENT_ID=frontend-sample
#
# onLoad behavior (see docs/auth-keycloak.md):
# - check-sso: silent SSO probe; user may stay anonymous until hitting a protected route or /login
# - login-required: redirects unauthenticated users to Keycloak immediately on app load
# VITE_KEYCLOAK_ON_LOAD=check-sso
#
# REQUIRED for check-sso: absolute URL to this app's static silent-check page (served from /public).
# Example local: http://localhost:3000/silent-check-sso.html
# Production: https://your-service.example.com/silent-check-sso.html
# VITE_KEYCLOAK_SILENT_CHECK_SSO_REDIRECT_URI=http://localhost:3000/silent-check-sso.html

# -----------------------------------------------------------------------------
# Cross-App SSO — Menu App / MiniApp navigation
# -----------------------------------------------------------------------------
# URL of the Menu App (shell). MiniApps use this for "back to menu" navigation.
# VITE_MENU_APP_URL=https://menu.example.com
#
# This template supports seamless SSO between Menu App and MiniApps:
# - All apps share the same Keycloak realm
# - MiniApps use check-sso to silently pick up existing session
# - No re-login required when navigating between apps

# -----------------------------------------------------------------------------
# MSW / mock API data in dev (see src/shared/api/mocks/browser.ts)
# -----------------------------------------------------------------------------
VITE_USE_MOCK_DATA=false

# -----------------------------------------------------------------------------
# E2E — Playwright baseURL (must match playwright.config.ts webServer; default port 4173)
# -----------------------------------------------------------------------------
# VITE_E2E_BASE_URL=http://localhost:4173

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
VITE_ENABLE_BETA_FEATURES=false

# -----------------------------------------------------------------------------
# Error Tracking (Sentry) — matches src/shared/config/env.ts
# -----------------------------------------------------------------------------
VITE_SENTRY_ENABLED=false
# VITE_SENTRY_DSN=https://your-dsn@sentry.io/project-id
# VITE_SENTRY_ENVIRONMENT=development
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Performance / debug
# -----------------------------------------------------------------------------
VITE_ENABLE_PERFORMANCE_MONITORING=false
VITE_DEBUG_MODE=false

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
VITE_ENABLE_REACT_QUERY_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# API client default timeout (ms) — http-client also has its own default
# -----------------------------------------------------------------------------
VITE_API_TIMEOUT=30000

# Load /config.json at startup (copy public/config.json.example → public/config.json)
VITE_USE_RUNTIME_CONFIG=true

# =============================================================================
# NOTES
# =============================================================================
# 1. Variables prefixed with VITE_ are exposed to the client
# 2. Server-only secrets should NOT use the VITE_ prefix
# 3. Always use .env.local for local overrides (git-ignored by default)
# 4. Never commit actual secrets - use a secrets manager in production
# =============================================================================
